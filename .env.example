# Database (PostgreSQL via Sequelize)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dpay
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE=dpay
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (Cache, Sessions, Rate Limiting, Fast Storage)
REDIS_URL=redis://127.0.0.1:6379

# Issuer Cryptographic Keys (P-256 for Note & Certificate Signing)
ISSUER_KEY_FILE=./secrets/issuer-key.pem
ISSUER_KEY_ID=1

# Application Security & Secrets
OTP_SECRET=your-32-byte-hex-encoded-otp-secret-key-here
ADMIN_API_KEY=your-24-character-or-longer-admin-api-key-here
EXPOSE_DEBUG_OTP=true

# Mock Bank & Infinite Money Engine
MOCK_BANK_NAME="DPay Reserve Bank"
MOCK_BANK_IFSC=DPAY0000001
MOCK_BANK_INFINITE_MONEY=true
MOCK_BANK_AUTO_LOAD=true

# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=true
STARTING_BALANCE_PAISE=2500000

# Hardware Key Attestation & Integrity (Option A: Direct APK distribution relying on Hardware Attestation)
ATTESTATION_MODE=off
ATTESTATION_ROOTS_FILE=./secrets/attestation-roots.pem
ANDROID_PACKAGE_NAME=com.qbitlog.dpay
# ANDROID_SIGNING_CERT_DIGESTS=40:C2:94:0F:96:1B:0C:59:47:5A:97:38:00:87:79:0C:06:D2:3B:38:13:42:D5:ED:AB:CD:BD:70:0F:38:29:5D
PLAY_INTEGRITY_MODE=off

